# Copy to .env (or set these in your host's dashboard) and adjust.

# SQLite for a local demo (default if unset):
DATABASE_URL=sqlite:///./retaildesk.db
# Free hosted Postgres (Neon / Supabase) — paste the connection string as-is;
# the app converts postgresql:// to the psycopg2 driver automatically:
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/dbname?sslmode=require

# JWT signing secret — use a long random value in production!
SECRET_KEY=change-this-to-a-long-random-string

# Frontend origins allowed to call the API (comma-separated, or * for demo):
ALLOWED_ORIGINS=*

# JWT lifetime in minutes (default 720 = 12h):
ACCESS_TOKEN_EXPIRE_MINUTES=720
